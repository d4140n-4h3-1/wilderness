// The sky: drawn on a box round the eye, at the far plane, where nothing else is - after the fog,
// so the haze lies on the forest, not on it. Every pixel works out the sky in its direction: a
// gradient from the haze at the horizon to the zenith's colour overhead, warm toward the sun as it
// rises and sets; the sun and the full moon opposite it, each with a glow; and at night the stars
// and the Milky Way, turning about the celestial pole as the night goes by. Colours are linear,
// as the renderer's light.
(
    name: "WildernessSky",

    resources: [
        (
            name: "properties",
            kind: PropertyGroup([
                (name: "zenith", kind: Vector3(value: (0.05, 0.15, 0.55))),
                (name: "horizon", kind: Vector3(value: (0.45, 0.53, 0.6))),
                (name: "glow", kind: Vector3(value: (0.8, 0.3, 0.15))),
                (name: "towardSun", kind: Vector3(value: (0.0, 1.0, 0.0))),
                (name: "towardMoon", kind: Vector3(value: (0.0, -1.0, 0.0))),
                (name: "sunColor", kind: Vector3(value: (1.0, 0.95, 0.85))),
                // 0 to 1: how much the sky glows toward the sun at the horizon; how bright the
                // stars are; how far round they have turned, in radians; and seconds, for their
                // twinkling.
                (name: "twilight", kind: Float(value: 0.0)),
                (name: "stars", kind: Float(value: 0.0)),
                (name: "starTurn", kind: Float(value: 0.0)),
                (name: "time", kind: Float(value: 0.0)),
            ]),
            binding: 2
        ),
        (
            name: "fyrox_instanceData",
            kind: PropertyGroup([
                // Autogenerated
            ]),
            binding: 0
        ),
        (
            name: "fyrox_cameraData",
            kind: PropertyGroup([
                // Autogenerated
            ]),
            binding: 1
        ),
    ],

    disabled_passes: ["GBuffer", "DirectionalShadow", "PointShadow", "SpotShadow"],

    passes: [
        (
            name: "Forward",
            draw_parameters: DrawParameters(
                cull_face: None,
                color_write: ColorMask(red: true, green: true, blue: true, alpha: true),
                depth_write: false,
                stencil_test: None,
                // At the far plane: drawn only where nothing else was.
                depth_test: Some(Less),
                blend: None,
                stencil_op: StencilOp(fail: Keep, zfail: Keep, zpass: Keep, write_mask: 0xFFFF_FFFF),
                scissor_box: None
            ),
            vertex_shader:
               r#"
                struct VertexOutput {
                    @builtin(position) position: vec4f,
                    @location(0) worldPosition: vec3f,
                };

                @vertex fn vs_main(@location(0) position: vec3f) -> VertexOutput {
                    var output: VertexOutput;
                    let local = vec4f(position, 1.0);
                    let clip = fyrox_instanceData.worldViewProjection * local;
                    // On the far plane, whatever the box's size.
                    output.position = vec4f(clip.xy, clip.w * 0.999999, clip.w);
                    output.worldPosition = (fyrox_instanceData.worldMatrix * local).xyz;
                    return output;
                }
               "#,

           fragment_shader:
               r#"
                // The celestial pole, 48 degrees up in the north (+z), as the sun's path assumes.
                const SKY_POLE: vec3f = vec3f(0.0, 0.7431448, 0.6691306);
                // The sun's and moon's radii, as cosines of the angle from their middles.
                const SKY_SUN_DISK: f32 = 0.99996;   // 0.5 degrees
                const SKY_MOON_DISK: f32 = 0.99997;  // 0.45 degrees

                fn skyHash(v0: vec3u) -> vec3u {
                    var v = v0 * 1664525u + 1013904223u;
                    v.x += v.y * v.z; v.y += v.z * v.x; v.z += v.x * v.y;
                    v ^= v >> vec3u(16u);
                    v.x += v.y * v.z; v.y += v.z * v.x; v.z += v.x * v.y;
                    return v;
                }

                fn skyRandom(cell: vec3f, seed: u32) -> vec3f {
                    let c = vec3i(cell);
                    let h = skyHash(vec3u(bitcast<u32>(c.x), bitcast<u32>(c.y), bitcast<u32>(c.z) ^ seed));
                    return vec3f(h) / 4294967295.0;
                }

                // Turns `v` by `angle` about the unit axis `axis`.
                fn skyTurn(v: vec3f, axis: vec3f, angle: f32) -> vec3f {
                    let c = cos(angle);
                    let s = sin(angle);
                    return v * c + cross(axis, v) * s + axis * dot(axis, v) * (1.0 - c);
                }

                // One layer of stars: the sky cut into cells `scale` to a radian or so, a star in
                // `density` of them, somewhere inside it (never at its edge, so never cut off),
                // as bright as chance has it - most faint, a few bright - a pixel or two across.
                fn skyStars(d: vec3f, scale: f32, density: f32, seed: u32) -> vec3f {
                    let cell = floor(d * scale);
                    let r = skyRandom(cell, seed);
                    if (r.x > density) {
                        return vec3f(0.0);
                    }
                    let spot = normalize(cell + 0.25 + 0.5 * skyRandom(cell, seed ^ 0x9e3779b9u));
                    let away = length(d - spot) * scale;
                    let pixel = max(fwidth(away), 1.0e-4);
                    let point = 1.0 - smoothstep(0.0, pixel * 1.6, away);
                    let bright = pow(r.y, 10.0) * 2.5 + 0.012;
                    // Some bluish, some yellowish, as stars are.
                    let tint = mix(vec3f(0.75, 0.85, 1.0), vec3f(1.0, 0.85, 0.65), r.z);
                    // Twinkling, a little.
                    let twinkle = 0.8 + 0.2 * sin(properties.time * (2.0 + 5.0 * r.z) + r.y * 40.0);
                    return tint * bright * point * twinkle;
                }

                // A soft, uneven cloud of light: the Milky Way's.
                fn skyHaze(p: vec3f) -> f32 {
                    return 0.5 + 0.25 * sin(p.x * 5.1 + sin(p.y * 3.3)) * sin(p.y * 4.7 + p.z * 2.1)
                               + 0.25 * sin(p.z * 9.3 - p.x * 6.2 + sin(p.y * 7.7));
                }

                @fragment fn fs_main(@location(0) worldPosition: vec3f) -> @location(0) vec4f {
                    let d = normalize(worldPosition - fyrox_cameraData.position);
                    let up = d.y;
                    let high = max(up, 0.0);
                    let sun = normalize(properties.towardSun);
                    let moon = normalize(properties.towardMoon);

                    // The gradient, and the warmth toward the sun near the horizon as it sets.
                    var sky = mix(properties.horizon, properties.zenith, pow(high, 0.45));
                    let across = normalize(vec2f(d.x, d.z) + vec2f(1.0e-5, 0.0));
                    let sunAcross = normalize(vec2f(sun.x, sun.z) + vec2f(1.0e-5, 0.0));
                    let towardSunSide = pow(max(dot(across, sunAcross), 0.0), 3.0);
                    sky = mix(sky, properties.glow, properties.twilight * towardSunSide * exp(-high * 5.0));

                    // The sun's glow about it, and its disk.
                    let cosSun = dot(d, sun);
                    let sunUp = smoothstep(-0.08, 0.02, sun.y);
                    sky += properties.sunColor * sunUp * (0.06 * pow(max(cosSun, 0.0), 8.0) + 0.3 * pow(max(cosSun, 0.0), 200.0));
                    sky += properties.sunColor * sunUp * 30.0 * smoothstep(SKY_SUN_DISK - 0.00002, SKY_SUN_DISK, cosSun);

                    // The stars and the Milky Way, at night: in the sky's own frame, turned about
                    // the pole as the night goes by; fading toward the horizon, where the air is
                    // thick, and near the moon.
                    let cosMoon = dot(d, moon);
                    let moonUp = smoothstep(-0.05, 0.03, moon.y);
                    if (properties.stars > 0.001) {
                        let c = skyTurn(d, SKY_POLE, -properties.starTurn);
                        // About as many as the eye sees on a clear night, a few thousand: most faint,
                        // a few hundred brighter.
                        var night = skyStars(c, 160.0, 0.01, 0x1234u) + skyStars(c, 55.0, 0.012, 0x8765u) * 3.0;
                        let band = exp(-pow(dot(c, normalize(vec3f(0.3, 0.45, -0.84))), 2.0) * 22.0);
                        night += vec3f(0.55, 0.6, 0.75) * 0.012 * band * skyHaze(c * 3.0);
                        let clear = smoothstep(-0.02, 0.2, up) * (1.0 - 0.8 * moonUp * pow(max(cosMoon, 0.0), 24.0));
                        sky += night * properties.stars * clear;
                    }

                    // The moon: a pale disk, a faint glow round it, at night.
                    let moonLight = vec3f(0.75, 0.8, 0.9) * moonUp * properties.stars;
                    sky += moonLight * (0.02 * pow(max(cosMoon, 0.0), 40.0));
                    sky += moonLight * 1.6 * smoothstep(SKY_MOON_DISK - 0.00002, SKY_MOON_DISK, cosMoon);

                    // Below the horizon - seen only past the edge of the land - the haze.
                    sky = mix(sky, properties.horizon, smoothstep(0.0, -0.08, up));
                    return vec4f(sky, 1.0);
                }
               "#,
        )
    ],
)
