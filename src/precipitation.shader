// Rain or snow falling round the eye, as plant_life's Birch Glade weather presets
// (environments/birch-glade/tools/weather.py, 56461bc) draw it: thin, see-through streaks of rain,
// or small flakes feathered at their edges, a little lit by the sky. There, two looping layers of
// particles before the camera; here, made for walking about in: one box of them, wrapped round
// the eye on the GPU, carried down and along by `fall` (how far they have fallen, which the game
// moves on with the wind each frame), so that wherever the eye goes it is in the middle of them.
// Those near the box's sides fade out, so none is seen jumping across it.
//
// Each particle is a quad, its four corners sharing its place in the box (the position) and told
// apart by the texture coordinates (-1 or 1 across, -1 or 1 along); the normal holds its own
// length and width, as shares of the most, and a number of its own for the flakes' tumbling.
(
    name: "WildernessPrecipitation",

    resources: [
        (
            name: "properties",
            kind: PropertyGroup([
                // The box's size, in meters across, up and along.
                (name: "box", kind: Vector3(value: (16.0, 10.0, 16.0))),
                // How far they have fallen and been blown along, in meters, wrapped by the box.
                (name: "fall", kind: Vector3(value: (0.0, 0.0, 0.0))),
                // The way they fall, a unit vector: the streaks lie along it.
                (name: "along", kind: Vector3(value: (0.0, -1.0, 0.0))),
                // x: the longest half-length, y: the widest half-width, in meters; z: 1 for snow,
                // 0 for rain; w: how opaque at most.
                (name: "shape", kind: Vector4(value: (0.15, 0.0016, 0.0, 0.6))),
                // Their colour, linear, and the light on them: the sky's.
                (name: "tint", kind: Vector3(value: (0.54, 0.65, 0.78))),
                (name: "light", kind: Vector3(value: (0.5, 0.5, 0.5))),
                // Seconds gone by, for the flakes' tumbling.
                (name: "time", kind: Float(value: 0.0)),
                // How many of the particles fall: 0 to 1.
                (name: "amount", kind: Float(value: 1.0)),
            ]),
            binding: 2
        ),
        (
            name: "fyrox_instanceData",
            kind: PropertyGroup([
                // Autogenerated
            ]),
            binding: 0
        ),
        (
            name: "fyrox_cameraData",
            kind: PropertyGroup([
                // Autogenerated
            ]),
            binding: 1
        ),
    ],

    disabled_passes: ["GBuffer", "DirectionalShadow", "PointShadow", "SpotShadow"],

    passes: [
        (
            name: "Forward",
            draw_parameters: DrawParameters(
                cull_face: None,
                color_write: ColorMask(red: true, green: true, blue: true, alpha: true),
                depth_write: false,
                stencil_test: None,
                depth_test: Some(Less),
                blend: Some(BlendParameters(
                    func: BlendFunc(
                        sfactor: SrcAlpha,
                        dfactor: OneMinusSrcAlpha,
                        alpha_sfactor: Zero,
                        alpha_dfactor: One,
                    ),
                    equation: BlendEquation(rgb: Add, alpha: Add)
                )),
                stencil_op: StencilOp(fail: Keep, zfail: Keep, zpass: Keep, write_mask: 0xFFFF_FFFF),
                scissor_box: None
            ),
            vertex_shader:
               r#"
                struct VertexOutput {
                    @builtin(position) position: vec4f,
                    // The corner, across and along, -1 to 1; and how opaque it is.
                    @location(0) corner: vec2f,
                    @location(1) opacity: f32,
                };

                // About a pixel's breadth, as an angle, at the window's usual size: a streak or
                // flake thinner than that is drawn a pixel wide, and fainter - but by less than
                // it is thinner, so that a streak of real rain's width, under a pixel a few meters
                // off, still shows as it does to the eye, and does not flicker in and out.
                const PIXEL: f32 = 0.0025;

                fn hidden() -> VertexOutput {
                    var output: VertexOutput;
                    output.position = vec4f(0.0, 0.0, 2.0, 1.0);
                    output.corner = vec2f(0.0);
                    output.opacity = 0.0;
                    return output;
                }

                @vertex fn vs_main(@location(0) position: vec3f, @location(1) uv: vec2f, @location(2) normal: vec3f) -> VertexOutput {
                    // Fewer of them, the lighter it falls: each its own number against `amount`.
                    if (fract(normal.z * 7.31) >= properties.amount) {
                        return hidden();
                    }
                    let size = properties.box;
                    let eye = fyrox_cameraData.position;
                    let snow = properties.shape.z;
                    // Its place, carried along by the fall, wrapped into the box round the eye.
                    var place = position + properties.fall;
                    // Flakes tumble from side to side as they fall.
                    let phase = normal.z * 6.2831853;
                    let t = properties.time;
                    place += snow * 0.18 * vec3f(sin(t * 1.3 + phase), 0.0, cos(t * 1.1 + phase * 1.7));
                    let relative = (fract((place - eye) / size) - 0.5) * size;
                    let world = eye + relative;
                    // Faded out near the box's sides.
                    let edge = max(max(abs(relative.x) / (0.5 * size.x), abs(relative.y) / (0.5 * size.y)), abs(relative.z) / (0.5 * size.z));
                    var opacity = properties.shape.w * (1.0 - smoothstep(0.7, 1.0, edge));

                    // Long along the fall, across it facing the eye; a flake square, facing it.
                    let toward = eye - world;
                    let distance = max(length(toward), 0.05);
                    let view = toward / distance;
                    var long_axis = properties.along;
                    var side = cross(long_axis, view);
                    if (length(side) < 1e-4) {
                        side = vec3f(1.0, 0.0, 0.0);
                    }
                    side = normalize(side);
                    if (snow > 0.5) {
                        long_axis = normalize(cross(view, side));
                    }
                    let half_length = properties.shape.x * normal.x;
                    var half_width = properties.shape.y * normal.y;
                    let least = PIXEL * distance * 0.5;
                    if (half_width < least) {
                        opacity *= sqrt(half_width / least);
                        half_width = least;
                    }
                    let corner_place = world + side * (uv.x * half_width) + long_axis * (uv.y * half_length);

                    var output: VertexOutput;
                    var clip = fyrox_cameraData.viewProjectionMatrix * vec4f(corner_place, 1.0);
                    output.position = clip;
                    output.corner = uv;
                    output.opacity = opacity;
                    return output;
                }
               "#,

           fragment_shader:
               r#"
                @fragment fn fs_main(@location(0) corner: vec2f, @location(1) opacity: f32) -> @location(0) vec4f {
                    var alpha = opacity;
                    if (properties.shape.z > 0.5) {
                        // A flake: feathered from its middle out, as plant_life's.
                        alpha *= 1.0 - smoothstep(0.3, 1.0, length(corner));
                    } else {
                        // A streak: thinning toward its ends.
                        alpha *= 1.0 - smoothstep(0.6, 1.0, abs(corner.y));
                    }
                    if (alpha <= 0.002) {
                        discard;
                    }
                    return vec4f(properties.tint * properties.light, alpha);
                }
               "#,
        ),
    ],
)
